.hud-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: absolute;
}

.heart-container {
    position: absolute;
    top: 24px;
    left: 28px;
    flex-direction: row;
}

.heart-slot {
    width: 28px;
    height: 28px;
    margin-right: 6px;
    background-color: rgba(51, 13, 13, 0.8);
    border-width: 2px;
    border-color: rgb(204, 26, 26);
    border-radius: 14px;
}

.action-prompt-box {
    position: absolute;
    bottom: 20px;
    right: 24px;
    background-color: rgba(0, 0, 0, 0.65);
    padding: 10px 14px;
    border-radius: 8px;
}
